# AI 국내 주식 예측 시스템 - 환경 변수
# ──────────────────────────────────────────────────────────────────────────
# 이 파일은 환경 변수를 정의하는 예제입니다.
# 실제 사용 시는 .env 파일을 복사하고 값을 수정하세요.
#
# 생성 방법:
#   cp .env.example .env
#
# ──────────────────────────────────────────────────────────────────────────

# 모드: 'simulation' (모의투자) or 'live' (실전)
MODE=simulation

# 시뮬레이션 시 True, 실전 시 False
SIMULATION_MODE=true

# KIS 실전 모드시 인증 토큰 (필요시 설정)
# KIS_AUTH_TOKEN=your_kis_auth_token_here

# 시뮬레이션 속도 (1=실시간, 10=10 배, 100=100 배)
SIMULATION_SPEED=1

# 로깅 레벨 (DEBUG, INFO, WARNING, ERROR)
LOG_LEVEL=INFO

# 포트 번호
BACKEND_PORT=8000
FRONTEND_PORT=8501

# 데이터 디렉토리 (버퍼 파일 저장 위치)
DATA_DIR=backend/data

# ONNX 모델 디렉토리
MODEL_DIR=backend/onnx_models

# ──────────────────────────────────────────────────────────────────────────
